<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>wine.wisco.apiary.kokoro</string>
  <key>ProgramArguments</key><array>
    <string>/Users/Storage/Apiary/services/kokoro/run.sh</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>$HOME</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$HOME/.apiary/logs/kokoro.log</string>
  <key>StandardErrorPath</key><string>$HOME/.apiary/logs/kokoro.log</string>
</dict></plist>
